# =========================
# Unity Generated Folders
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# =========================
# MemoryCaptures
# =========================
MemoryCaptures/

# =========================
# Asset meta data (keep meta files!)
# =========================
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta

# =========================
# Visual Studio / Rider / VSCode
# =========================
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Rider
.idea/

# VSCode
.vscode/

# =========================
# OS Generated Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Crash Reports
# =========================
sysinfo.txt

# =========================
# Unity Collaborate (deprecated)
# =========================
.collab/

# =========================
# Gradle (Android)
# =========================
.gradle/
build/

# =========================
# Autogenerated JetBrains plugin
# =========================
.idea/

# =========================
# Addressables
# =========================
ServerData/

# =========================
# Streaming Assets (optional large files)
# =========================
# Assets/StreamingAssets/*

# =========================
# Packages cache (keep manifest)
# =========================
Packages/packages-lock.json

# =========================
# IL2CPP Builds
# =========================
il2cpp_cache/

# =========================
# Android keystore (sensitive)
# =========================
*.keystore
*.jks

# =========================
# iOS Builds
# =========================
*.xcworkspace
*.xcuserstate

# =========================
# Debug Logs
# =========================
*.log

# =========================
# ADDITIONAL SIZE REDUCTION (Add these)
# =========================
# Ignore heavy source files (Unity uses the exported versions)
*.psd
*.blend
*.mb
*.ma

# Ignore local editor databases and cache
*.opendb
*.db-shm
*.db-wal
.vsconfig

# Ignore Asset Store temp downloads
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/SceneBackups/